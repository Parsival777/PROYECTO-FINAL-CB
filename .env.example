# ===========================================
# Variables de Entorno - Proyecto Final CB
# ===========================================
# Copiar este archivo a .env y reemplazar valores

# Flask Secret Key (GENERAR UNA CLAVE ALEATORIA)
SECRET_KEY=tu_clave_secreta_aqui_cambiar_en_produccion

# Database
DATABASE_URL=sqlite:///lab_app.db
DEBUG=False

# Security Headers
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict

# Rate Limiting Nginx
RATE_LIMIT=10r/s

# Admin Email (para notificaciones)
ADMIN_EMAIL=admin@tecmihealth.edu